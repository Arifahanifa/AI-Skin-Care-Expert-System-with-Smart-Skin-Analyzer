# ==============================================================
# AI Skin Care Expert System - Environment Variables Template
# ==============================================================

# --- Backend Configuration ---
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=0
CORS_ORIGINS=*

# Custom persistent path for SQLite (e.g., when mounting persistent volume)
DATABASE_PATH=backend/skincare_expert.db

# Email / SMTP Password Reset Service (Optional)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# --- Frontend Configuration ---
# Leave empty for local development (uses Vite /api proxy).
# For production deployment (e.g. Vercel), set to your deployed backend URL:
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
VITE_API_BASE_URL=
